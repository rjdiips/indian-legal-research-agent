# Copy to .env. Never commit .env (internal hosts and keys stay out of the repo).

# gpu4090 | laptop4060  (project-prds/README.md, "Runtime profiles")
RUNTIME_PROFILE=laptop4060

# LLM backend order (PRD-004 §8, "LLM backends"): local first, OpenCode Go as backup.
# 1. Local. gpu4090: the vLLM server's address (keep it local); only request the served model ID.
#    laptop4060: a small local model's OpenAI-compatible address.
# 2. OpenCode Go chat model (e.g. a Qwen/GLM/Kimi ID from https://opencode.ai/inference/go/v1/models).
#    Most use https://opencode.ai/inference/go/openai/v1. Keep Extra Usage off.
# 3. OpenRouter free tier (optional zero-cost fallback):
#    LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openrouter/qwen/qwen3-30b-a3b:free
LLM_BASE_URL=
LLM_MODEL=
OPENCODE_GO_API_KEY=
OPENROUTER_API_KEY=

# Typed decision model (PRD-004 §8, "Decision model backends"): local first, hosted Jev as backup.
# local | jev
DECISION_BACKEND=local
# Hosted Jev: jev-1.13-free (free, limited time) or jev-1.13 (pay-as-you-go Console credit).
# Not OpenAI-compatible; called by its own adapter, not LiteLLM.
JEV_BASE_URL=https://opencode.ai/inference/systemone/v1/systemone
JEV_MODEL=jev-1.13-free
OPENCODE_API_KEY=

DATABASE_URL=postgresql://legal:legal@localhost:5440/legal
DATA_DIR=./data
CACHE_PATH=./data/cache/responses.sqlite

# Hard caps (PRD §7: retrieval retries limited to two)
MAX_RETRIEVAL_RETRIES=2
MAX_PARALLEL_LLM_CALLS=2

# Published MCP server data home (used by the package's `init`)
SC_JUDGMENTS_HOME=./data/sc-judgments
